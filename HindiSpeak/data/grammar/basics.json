
{
  "category": "Basics",
  "topics": [
    {
      "id": "pronouns",
      "title": "Hindi Pronouns",
      "icon": "👤",
      "description": "Learn Main, Tum, Aap, Hum and other pronouns.",
      "level": "Beginner",
      "lesson": {
        "introduction": "Pronouns are words used instead of names or nouns. In Hindi, pronouns are called Sarvanam.",
        "points": [
          {
            "title": "First Person",
            "description": "Used when talking about yourself or a group including yourself.",
            "examples": [
              {
                "hindi": "मैं घर जाता हूँ।",
                "roman": "Main ghar jaata hoon.",
                "english": "I go home."
              },
              {
                "hindi": "हम स्कूल जाते हैं।",
                "roman": "Hum school jaate hain.",
                "english": "We go to school."
              }
            ]
          },
          {
            "title": "Second Person",
            "description": "Used when talking to another person.",
            "examples": [
              {
                "hindi": "तुम अच्छे हो।",
                "roman": "Tum achhe ho.",
                "english": "You are good."
              },
              {
                "hindi": "आप कैसे हैं?",
                "roman": "Aap kaise hain?",
                "english": "How are you?"
              }
            ]
          },
          {
            "title": "Third Person",
            "description": "Used when talking about another person.",
            "examples": [
              {
                "hindi": "वह मेरा दोस्त है।",
                "roman": "Vah mera dost hai.",
                "english": "He is my friend."
              },
              {
                "hindi": "वे घर पर हैं।",
                "roman": "Ve ghar par hain.",
                "english": "They are at home."
              }
            ]
          }
        ],
        "table": [
          {
            "english": "I",
            "hindi": "मैं",
            "roman": "Main"
          },
          {
            "english": "You (informal)",
            "hindi": "तुम",
            "roman": "Tum"
          },
          {
            "english": "You (respectful)",
            "hindi": "आप",
            "roman": "Aap"
          },
          {
            "english": "He / She",
            "hindi": "वह",
            "roman": "Vah"
          },
          {
            "english": "We",
            "hindi": "हम",
            "roman": "Hum"
          },
          {
            "english": "They",
            "hindi": "वे",
            "roman": "Ve"
          }
        ]
      },
      "questions": [
        {
          "type": "mcq",
          "question": "What is the Hindi word for 'I'?",
          "options": ["Tum", "Main", "Hum", "Vah"],
          "answer": "Main",
          "explanation": "Main (मैं) means I."
        },
        {
          "type": "mcq",
          "question": "Which pronoun is used to respectfully address someone?",
          "options": ["Tum", "Vah", "Aap", "Hum"],
          "answer": "Aap",
          "explanation": "Aap (आप) is used to address someone respectfully."
        },
        {
          "type": "fill",
          "question": "Complete: ___ मेरा दोस्त है। (He is my friend.)",
          "answer": ["Vah", "Woh"],
          "explanation": "Vah (वह) means he or she."
        },
        {
          "type": "mcq",
          "question": "What does Hum mean?",
          "options": ["I", "You", "We", "He"],
          "answer": "We",
          "explanation": "Hum (हम) means we."
        }
      ]
    },
    {
      "id": "helping-verbs",
      "title": "Helping Verbs",
      "icon": "🔤",
      "description": "Understand Hai, Hoon, Ho and Hain.",
      "level": "Beginner",
      "lesson": {
        "introduction": "Helping verbs help complete a sentence. Hindi uses different forms of the verb Hona (to be).",
        "points": [
          {
            "title": "Hoon (हूँ)",
            "description": "Generally used with Main (I).",
            "examples": [
              {
                "hindi": "मैं खुश हूँ।",
                "roman": "Main khush hoon.",
                "english": "I am happy."
              }
            ]
          },
          {
            "title": "Ho (हो)",
            "description": "Used with Tum (you, informal).",
            "examples": [
              {
                "hindi": "तुम अच्छे हो।",
                "roman": "Tum achhe ho.",
                "english": "You are good."
              }
            ]
          },
          {
            "title": "Hai (है)",
            "description": "Generally used with singular third-person subjects.",
            "examples": [
              {
                "hindi": "वह खुश है।",
                "roman": "Vah khush hai.",
                "english": "He is happy."
              }
            ]
          },
          {
            "title": "Hain (हैं)",
            "description": "Used with Aap, Hum and plural subjects.",
            "examples": [
              {
                "hindi": "आप अच्छे हैं।",
                "roman": "Aap achhe hain.",
                "english": "You are good."
              }
            ]
          }
        ],
        "table": [
          {
            "english": "I",
            "hindi": "मैं",
            "roman": "Main + Hoon"
          },
          {
            "english": "You (informal)",
            "hindi": "तुम",
            "roman": "Tum + Ho"
          },
          {
            "english": "He / She",
            "hindi": "वह",
            "roman": "Vah + Hai"
          },
          {
            "english": "We",
            "hindi": "हम",
            "roman": "Hum + Hain"
          },
          {
            "english": "You (respectful)",
            "hindi": "आप",
            "roman": "Aap + Hain"
          }
        ]
      },
      "questions": [
        {
          "type": "mcq",
          "question": "Complete: Main khush ___ .",
          "options": ["Hai", "Ho", "Hoon", "Hain"],
          "answer": "Hoon",
          "explanation": "Main is generally used with Hoon."
        },
        {
          "type": "mcq",
          "question": "Complete: Tum achhe ___ .",
          "options": ["Hai", "Ho", "Hoon", "Hain"],
          "answer": "Ho",
          "explanation": "Tum is used with Ho."
        },
        {
          "type": "fill",
          "question": "Complete: Vah mera dost ___ .",
          "answer": ["Hai"],
          "explanation": "Vah is singular, so use Hai."
        },
        {
          "type": "mcq",
          "question": "Complete: Aap kaise ___ ?",
          "options": ["Hai", "Ho", "Hoon", "Hain"],
          "answer": "Hain",
          "explanation": "Aap is respectful, so use Hain."
        }
      ]
    }
  ]
}
